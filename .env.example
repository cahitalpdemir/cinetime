# Copy this file to .env and adjust values for your local environment.
DB_URL=jdbc:postgresql://localhost:5432/cinetime_db
DB_USERNAME=db_user
DB_PASSWORD=password

JWT_SECRET=replace-with-at-least-32-characters
TICKET_QR_SECRET=replace-with-another-at-least-32-character-secret
ADMIN_EMAIL=admin@cinetime.com
ADMIN_PASSWORD=ChangeMe123!

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

MAIL_FROM=no-reply@cinetime.local
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
BOOKING_CANCELLATION_CUTOFF_MINUTES=120
