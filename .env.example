# Copy this file to .env for local runs, or create these values as deployment environment variables.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081
# Many cloud platforms provide PORT automatically. Spring will use PORT before SERVER_PORT.

DB_URL=jdbc:postgresql://localhost:5432/cinetime_db
# Render-style Postgres URL is also supported and normalized at startup.
DATABASE_URL=
DB_USERNAME=db_user
DB_PASSWORD=password

JWT_SECRET=replace-with-at-least-32-characters
TICKET_QR_SECRET=replace-with-another-at-least-32-character-secret
ADMIN_EMAIL=admin@cinetime.com
ADMIN_PASSWORD=ChangeMe123!

# Use redis for production. Use memory only for one-instance demo/staging deployments.
REFRESH_TOKEN_STORE=redis
# Render Key Value internal URL is also supported.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_HEALTH_ENABLED=false

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_FROM=no-reply@cinetime.local
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

SWAGGER_UI_ENABLED=false
API_DOCS_ENABLED=false
BOOKING_CANCELLATION_CUTOFF_MINUTES=120
